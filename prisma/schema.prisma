// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  twoFactorEnabled Boolean?  @default(false)
  username         String?
  displayUsername  String?
  sessions         Session[]
  accounts         Account[]
  reports          Report[]

  @@unique([email])
  // @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Report {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  category    String // "Sampah", "Drainase/Banjir", "Polusi", "Kebakaran", "Fasilitas Rusak", "Lainnya"
  urgency     String @default("Sedang") // "Rendah", "Sedang", "Tinggi", "Sangat Tinggi"
  status      String @default("PENDING") // PENDING, VERIFIED, IN_PROGRESS, RESOLVED, REJECTED

  // Lokasi
  locationName String
  latitude     Float?
  longitude    Float?

  // Foto/Media
  images String[]

  // Asal dan bukti laporan. Semua laporan tetap memakai koleksi Report yang sama.
  source               String   @default("HUMAN")
  sourceConfidence     Float?
  sourceMetadata       Json?
  deduplicationKey     String?  @unique
  observedAt           DateTime?
  accuracyRadiusMeters Int?

  // Relasi ke User
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relasi 1-to-1 ke EcoLensAnalysis
  ecolensAnalysis EcoLensAnalysis?

  // Relasi opsional ke kelompok insiden dan hasil analisis risiko.
  incidentClusterId String?               @db.ObjectId
  incidentCluster   IncidentCluster?      @relation(fields: [incidentClusterId], references: [id], onDelete: SetNull)
  riskAssessment    ReportRiskAssessment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([source])
  @@index([incidentClusterId])
  @@map("report")
}

model EcoLensAnalysis {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relasi ke Report
  reportId String @unique @db.ObjectId
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Data Hasil Prediksi AI
  category             String
  urgency              String
  summary              String
  suggestedDescription String
  confidence           Float?
  visionModel          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ecolens_analysis")
}

model IncidentCluster {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  category        String
  status          String   @default("ACTIVE")
  centerLatitude  Float
  centerLongitude Float
  reports         Report[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, status])
  @@map("incident_cluster")
}

model ReportRiskAssessment {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  reportId            String    @unique @db.ObjectId
  report              Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status              String    @default("PENDING")
  score               Int?
  level               String?
  confidence          Float?
  summary             String?
  horizons            Json?
  factors             String[]  @default([])
  potentialImpacts    String[]  @default([])
  recommendedActions  String[]  @default([])
  environmentSnapshot Json?
  nearbyReportCount   Int       @default(0)
  nearbyReportIds     String[]  @default([]) @db.ObjectId
  providerStatus      Json?
  model               String?
  attemptCount        Int       @default(0)
  lastAttemptAt       DateTime?
  errorCode           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@map("report_risk_assessment")
}
